# Copy to .env. Values already set in the environment win over this file.

# https://dev.to/settings/extensions — DEV API key
DEV_API_KEY=
# https://platform.inceptionlabs.ai
INCEPTION_API_KEY=

# Numeric id from the seed command, or from the article's API response.
ARTICLE_ID=

DEV_BASE_URL=https://dev.to/api
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-2.5

# Your DEV username. Own comments are skipped unless SKIP_AUTHOR=false,
# which is how you rehearse on a live article before strangers arrive.
AUTHOR_USERNAME=varshithvhegde
SKIP_AUTHOR=true

# Story rewrites that call Mercury. Cheap rejects have a separate cap.
MAX_COMMENTS_PER_RUN=3
MAX_BOOKKEEPING_PER_RUN=20
MAX_COMMENT_CHARS=600
MIN_COMMENT_CHARS=12
MAX_PROSE_CHARS=24000
MAX_LIQUID_TAGS=15
MAX_TAG_ARG_CHARS=300

# Stop weaving after this many woven comments, or at an ISO timestamp.
FREEZE_AFTER=200
FREEZE_AT=

MAX_RETRIES=4
RETRY_BASE_MS=800
MODEL_ATTEMPTS=3
